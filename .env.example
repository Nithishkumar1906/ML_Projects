# Copy to `.env` and fill in your own keys. `.env` is git-ignored - never commit it.

# Google AI Studio (Gemini) - used by the Flask apps and the RAG / Gradio notebooks
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEM_API_KEY=

# Groq (OpenAI-compatible endpoint) - used by the LangChain / LangGraph notebooks
GROQ_API_KEY=
OPENAI_API_KEY=

# Pinecone - used by the vector-store notebooks
PINECONE_API_KEY=

# Optional: Hugging Face Hub (gated models, e.g. Gemma) and Replicate (text-to-image)
HF_TOKEN=
REPLICATE_API_TOKEN=
